# Copy to .env at the repository root. Both applications load this file.
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# PostgreSQL: DATABASE_URL takes precedence over PG_* settings.
# DATABASE_URL=postgresql://app:app@localhost:5432/app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# API and public web origin. In production, use the public HTTPS web URL.
API_HOST=0.0.0.0
API_PORT=5000
WEB_ORIGIN=http://localhost:3000
BETTER_AUTH_BASE_URL=http://localhost:3000/api/auth

# SMTP settings for transactional email. Empty SMTP_USER/PASSWORD disables auth.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Food Helper <noreply@localhost>

# Next.js forwards /api requests to Fastify, preserving session cookies.
API_INTERNAL_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=/api