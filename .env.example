# Copy to .env at the repository root. Both applications load this file.
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# PostgreSQL: DATABASE_URL takes precedence over PG_* settings.
# DATABASE_URL=postgresql://app:app@localhost:5432/app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# API and public web origin. In production, use the public HTTPS web URL.
API_HOST=0.0.0.0
API_PORT=5000
WEB_ORIGIN=http://localhost:3000
BETTER_AUTH_BASE_URL=http://localhost:3000/api/auth

# Resend transactional email (https://resend.com/api-keys). Required outside
# development; without it, development logs verification links to the console.
# onboarding@resend.dev only delivers to your own Resend account address, so
# production needs a sender on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Food Helper <onboarding@resend.dev>

# Next.js forwards /api requests to Fastify, preserving session cookies.
API_INTERNAL_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=/api