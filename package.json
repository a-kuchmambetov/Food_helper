{
  "name": "food-helper",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @repo/api --filter @repo/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint --deny-warnings apps packages",
    "test": "pnpm -r test:run",
    "db:migrate": "pnpm --filter @repo/api db:migrate",
    "db:generate": "pnpm --filter @repo/api db:generate",
    "better-auth:schema": "pnpm --filter @repo/api exec auth generate --config ./src/plugins/auth/auth.ts --output ./src/db/schema/auth.ts",
    "lint:fix": "oxlint --fix --deny-warnings apps packages",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.24.0"
}
